# Copy to .env and fill in real values. Never commit the real .env.

# Django
SECRET_KEY=change-me
# Comma-separated extra origins allowed to call the API (frontend dev server, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (Neon in prod; local Postgres container in docker compose)
DB_NAME=jawak
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# 'require' for Neon; 'disable' for the local Postgres container.
DB_SSLMODE=require

# Password used by the local Postgres container in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Google OAuth (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/user/auth/google/

# AWS S3 (optional — falls back to local media/ when unset)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
